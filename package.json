{
  "name": "hearthstone-hud",
  "version": "1.0.2",
  "type": "module",
  "description": "Hearthstone deck HUD and arena helper for Decky Loader on Linux / SteamOS",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-frontend.mjs",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v && node scripts/test-frontend.mjs",
    "package": "python3 scripts/package.py"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "4.53.3",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "react-icons": "5.3.0",
    "tslib": "2.8.1"
  }
}
